# =============================================================================
# Configuration de Génial Coloc
# Copier ce fichier en .env puis renseigner les valeurs.
#   cp .env.example .env
# Ces variables sont lues au BUILD (npm run build / docker compose build).
# Après modification, il faut donc rebuild pour qu'elles soient prises en compte.
# =============================================================================

# --- Stockage partagé en temps réel (optionnel) ------------------------------
# Sans ces deux variables, l'app stocke les offres dans le navigateur local.
# Pour un stockage partagé : créer un projet sur https://supabase.com,
# exécuter supabase/schema.sql, puis copier les clés (Project Settings > API).
# VITE_SUPABASE_URL sans le suffixe /rest/v1/. La clé anon est publique par
# conception (protégée côté base par les règles RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Colocataires ------------------------------------------------------------
# Noms des colocataires, séparés par une virgule. Le premier est celui
# sélectionné par défaut. Exemple : Angelo,Nathalie
VITE_ROOMMATES=Enzo,Esteban

# --- Lieu de référence -------------------------------------------------------
# Le point vers lequel les temps de trajet (TCL, vélo) sont calculés, et le
# marqueur affiché sur la carte. Par défaut : campus Lyon 2 Porte des Alpes.
# lat/lng en degrés décimaux (récupérables sur Google Maps : clic droit >
# « Plus d'infos sur cet endroit », ou copier les coordonnées).
VITE_REFERENCE_NAME=Lyon 2 — Campus Porte des Alpes
VITE_REFERENCE_LAT=45.722593
VITE_REFERENCE_LNG=4.915127

# --- Déploiement Docker ------------------------------------------------------
# Port exposé sur le VPS (le conteneur écoute en interne sur le 80).
PORT=8080
