# =============================================================================
# Configuration de Génial Coloc
# Copier ce fichier en .env puis renseigner les valeurs.
#   cp .env.example .env
# Les variables VITE_ sont lues au BUILD (npm run build / docker compose build).
# Après modification, il faut donc rebuild pour qu'elles soient prises en compte.
# =============================================================================

# --- Colocataires ------------------------------------------------------------
# Noms des colocataires, séparés par une virgule. Le premier est celui
# sélectionné par défaut. Exemple : Angelo,Nathalie
VITE_ROOMMATES=Enzo,Esteban

# --- Lieu de référence -------------------------------------------------------
# Le point vers lequel les temps de trajet (TCL, vélo) sont calculés, et le
# marqueur affiché sur la carte. Par défaut : campus Lyon 2 Porte des Alpes.
# lat/lng en degrés décimaux (récupérables sur Google Maps : clic droit sur le
# lieu, puis cliquer sur les coordonnées pour les copier).
VITE_REFERENCE_NAME=Lyon 2 — Campus Porte des Alpes
VITE_REFERENCE_LAT=45.722593
VITE_REFERENCE_LNG=4.915127

# =============================================================================
# Stockage — choisir UN mode. Sans aucune config, l'app stocke les offres dans
# le navigateur local (localStorage), sans partage ni médias.
# =============================================================================

# --- Mode auto-hébergé (recommandé pour un VPS via docker compose) -----------
# La stack docker-compose fournit tout : PostgreSQL + API + médias sur disque.
# Le front tape sur /api (même origine, proxy nginx) : laisser VITE_API_URL=/api.
VITE_API_URL=/api
# Identifiants de la base PostgreSQL (conteneur `db`). À personnaliser.
POSTGRES_USER=coloc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coloc
# Secret de signature des URLs médias (facultatif : aléatoire si vide).
# Pour des URLs stables entre redémarrages, mettre une longue chaîne aléatoire.
MEDIA_SECRET=

# --- Mode Supabase (alternative, ex. déploiement Vercel) ---------------------
# Ne PAS combiner avec VITE_API_URL (l'API maison a la priorité). Laisser
# VITE_API_URL vide pour utiliser Supabase. Créer un projet sur supabase.com,
# exécuter supabase/schema.sql, puis copier les clés (Project Settings > API).
# VITE_SUPABASE_URL sans le suffixe /rest/v1/. La clé anon est publique.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Déploiement Docker ------------------------------------------------------
# Port exposé sur le VPS (le conteneur web écoute en interne sur le 80).
PORT=8080
